      <Atom name="H03" type="tip3p-H" charge="0.417"/>
      <Atom name="H04" type="tip3p-H" charge="0.417"/>
      <Bond atomName1="O01" atomName2="H03"/>
      <Bond atomName1="O01" atomName2="H04"/>
    </Residue>
